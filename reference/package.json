{
  "name": "lga-study-explorer",
  "productName": "LGA Study Explorer",
  "version": "1.0.0",
  "description": "Consultation screen for LGA Visa: destinations, universities and courses",
  "main": "main.js",
  "author": "Lanka Global Access (Pvt) Ltd",
  "scripts": {
    "start": "electron .",
    "kiosk": "electron . --kiosk",
    "dist": "electron-builder --win --x64"
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.lgavisa.studyexplorer",
    "productName": "LGA Study Explorer",
    "files": ["main.js", "index.html", "data/**", "img/**"],
    "win": { "target": "nsis", "icon": "img/logo.png" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  }
}
