{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LGA Study Visa Explorer",
  "version": "2.0.0",
  "identifier": "com.lgavisa.studyvisaexplorer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LGA Study Visa Explorer",
        "width": 1600,
        "height": 900,
        "center": true,
        "fullscreen": false,
        "resizable": true,
        "backgroundColor": "#0B1F3A"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' asset: http://asset.localhost",
        "connect-src": "'self' asset: http://asset.localhost ipc: http://ipc.localhost",
        "img-src": "'self' asset: http://asset.localhost https: data: blob:",
        "font-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "script-src": "'self'",
        "frame-src": "'none'",
        "object-src": "'none'",
        "base-uri": "'self'"
      },
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/lga-study-visa-explorer/**/*", "$RESOURCE/**/*"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
