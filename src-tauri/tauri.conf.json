{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LGA Study Visa Explorer",
  "version": "0.1.2",
  "identifier": "com.lgavisa.studyvisaexplorer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LGA Study Visa Explorer",
        "width": 1600,
        "height": 900,
        "center": true,
        "fullscreen": false,
        "resizable": true,
        "backgroundColor": "#0B1F3A",
        "visible": false,
        "minWidth": 1024,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' asset: http://asset.localhost",
        "connect-src": "'self' asset: http://asset.localhost ipc: http://ipc.localhost",
        "img-src": "'self' asset: http://asset.localhost https: data: blob:",
        "font-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "script-src": "'self'",
        "frame-src": "'none'",
        "object-src": "'none'",
        "base-uri": "'self'"
      },
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/lga-study-visa-explorer/**/*", "$RESOURCE/**/*"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Lanka Global Access (Pvt) Ltd",
    "copyright": "Copyright © 2026 Lanka Global Access (Private) Limited. All rights reserved.",
    "category": "Education",
    "shortDescription": "Study-visa consultation presenter for LGA Visa",
    "longDescription": "Full-screen presentation app LGA Visa consultants use to walk students through destinations, universities, courses, visas and work rights. Works offline; keeps its course catalogue up to date automatically.",
    "homepage": "https://lgavisa.com",
    "licenseFile": "../LICENSE",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU1QUIxMEYzQzY5RkMzNTcKUldSWHc1L0c4eENyVlhvaS84Nmp0TU50QkVPU2F6L0RqbHlxZDQxclJWTDJDVXdsc3RacWdOVk8K",
      "endpoints": [
        "https://github.com/charithmadhuranga/lga-study-visa-explorer/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
