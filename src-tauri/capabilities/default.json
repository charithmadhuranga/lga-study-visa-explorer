{
  "$schema": "gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities for the main presentation window. Grant the minimum: every entry here must be justified by a SPEC FR (AGENTS \u00a73).",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-set-fullscreen",
    "core:window:allow-is-fullscreen",
    "clipboard-manager:allow-write-text",
    "store:default",
    "updater:allow-check",
    "updater:allow-download-and-install",
    "process:allow-restart"
  ]
}
